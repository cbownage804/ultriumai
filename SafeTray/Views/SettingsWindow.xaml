&lt;Window x:Class="SafeTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeTray Settings" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"&gt;
    &lt;Grid Margin="20"&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="*"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;!-- Header --&gt;
        &lt;TextBlock Grid.Row="0" Text="SafeTray Settings" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/&gt;

        &lt;!-- Device Information --&gt;
        &lt;GroupBox Grid.Row="1" Header="Device Information" Margin="0,0,0,10"&gt;
            &lt;StackPanel Margin="10"&gt;
                &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                        &lt;ColumnDefinition Width="120"/&gt;
                        &lt;ColumnDefinition Width="*"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;Grid.RowDefinitions&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                    &lt;/Grid.RowDefinitions&gt;

                    &lt;TextBlock Grid.Row="0" Grid.Column="0" Text="Device ID:" VerticalAlignment="Center"/&gt;
                    &lt;TextBox Grid.Row="0" Grid.Column="1" x:Name="DeviceIdTextBox" IsReadOnly="True" Margin="5,2"/&gt;

                    &lt;TextBlock Grid.Row="1" Grid.Column="0" Text="Last Check-in:" VerticalAlignment="Center"/&gt;
                    &lt;TextBox Grid.Row="1" Grid.Column="1" x:Name="LastCheckinTextBox" IsReadOnly="True" Margin="5,2"/&gt;

                    &lt;TextBlock Grid.Row="2" Grid.Column="0" Text="Service Status:" VerticalAlignment="Center"/&gt;
                    &lt;TextBox Grid.Row="2" Grid.Column="1" x:Name="ServiceStatusTextBox" IsReadOnly="True" Margin="5,2"/&gt;
                &lt;/Grid&gt;
            &lt;/StackPanel&gt;
        &lt;/GroupBox&gt;

        &lt;!-- Actions --&gt;
        &lt;GroupBox Grid.Row="2" Header="Actions" Margin="0,0,0,10"&gt;
            &lt;StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center"&gt;
                &lt;Button x:Name="RunScanButton" Content="Run Network Scan" Width="120" Height="30" Margin="5" Click="RunScanButton_Click"/&gt;
                &lt;Button x:Name="SendCheckinButton" Content="Send Check-in" Width="120" Height="30" Margin="5" Click="SendCheckinButton_Click"/&gt;
                &lt;Button x:Name="ReconnectButton" Content="Reconnect Service" Width="120" Height="30" Margin="5" Click="ReconnectButton_Click"/&gt;
            &lt;/StackPanel&gt;
        &lt;/GroupBox&gt;

        &lt;!-- Status Log --&gt;
        &lt;GroupBox Grid.Row="3" Header="Status Log" Margin="0,0,0,10"&gt;
            &lt;ScrollViewer Height="150" VerticalScrollBarVisibility="Auto"&gt;
                &lt;TextBox x:Name="StatusLogTextBox" IsReadOnly="True" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="Black" Foreground="LightGreen" FontFamily="Consolas"/&gt;
            &lt;/ScrollViewer&gt;
        &lt;/GroupBox&gt;

        &lt;!-- Bottom buttons --&gt;
        &lt;StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"&gt;
            &lt;Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="30" Margin="5,0" Click="RefreshButton_Click"/&gt;
            &lt;Button x:Name="CloseButton" Content="Close" Width="80" Height="30" Margin="5,0" Click="CloseButton_Click"/&gt;
        &lt;/StackPanel&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;