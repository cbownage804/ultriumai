<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX 4 MSI Installer for Vanguard Agent -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ultrium Vanguard Agent"
           Manufacturer="Ultrium AI"
           Version="1.2.0"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Vanguard Agent is already installed." />

    <Media Id="1" Cabinet="vanguard.cab" EmbedCab="yes" />

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="VanguardIcon" SourceFile="$(var.PublishDir)\vanguard.ico" />
    <Property Id="ARPPRODUCTICON" Value="VanguardIcon" />
    <Property Id="ARPHELPLINK" Value="https://ultriumai.com/vanguard" />
    <Property Id="ARPURLINFOABOUT" Value="https://ultriumai.com" />

    <!-- Installation directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vanguard">
        <Component Id="MainExecutable" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <File Id="VanguardAgentExe" 
                Source="$(var.PublishDir)\VanguardAgent.exe" 
                KeyPath="yes" />
          <File Id="ConfigJson" 
                Source="$(var.PublishDir)\config.json" />
          <File Id="VanguardIco" 
                Source="$(var.PublishDir)\vanguard.ico" />

          <!-- Windows Service installation (must be in the same component as the service EXE file) -->
          <ServiceInstall Id="VanguardAgentService"
                          Name="VanguardAgent"
                          DisplayName="Ultrium Vanguard Agent"
                          Description="Enterprise RMM agent for Ultrium Vanguard platform"
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Arguments="--service" />
          <ServiceControl Id="StartVanguardService"
                          Name="VanguardAgent"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Registry entries for configuration -->
        <Component Id="RegistryEntries" Guid="D4E5F6A7-B8C9-0123-DEF0-234567890123">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Ultrium\Vanguard">
            <RegistryValue Type="string" Name="InstallPath" Value="[INSTALLFOLDER]" />
            <RegistryValue Type="string" Name="Version" Value="1.2.0" />
          </RegistryKey>
        </Component>

        <!-- Tray auto-start for workstations (controlled by ENABLETRAY property) -->
        <Component Id="TrayAutoStart" Guid="E5F6A7B8-C9D0-1234-EF01-345678901234" Condition="ENABLETRAY=1">
          <RegistryValue Root="HKLM" 
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" 
                         Name="VanguardPortal" 
                         Type="string" 
                         Value="&quot;[INSTALLFOLDER]VanguardAgent.exe&quot;" 
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut (always installed for manual portal access) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="VanguardMenuFolder" Name="Vanguard">
        <Component Id="StartMenuShortcut" Guid="F6A7B8C9-D0E1-2345-F012-456789012345">
          <Shortcut Id="VanguardPortalShortcut"
                    Name="Vanguard Portal"
                    Description="Open Vanguard Customer Portal"
                    Target="[INSTALLFOLDER]VanguardAgent.exe"
                    Icon="VanguardIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveVanguardMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="SOFTWARE\Ultrium\Vanguard" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Feature definition -->
    <Feature Id="ProductFeature" Title="Vanguard Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="TrayAutoStart" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Custom properties for silent install -->
    <Property Id="USERID" Secure="yes" />
    <Property Id="SECRETKEY" Secure="yes" />
    <Property Id="CLIENTID" Secure="yes" />
    <Property Id="DEVICENAME" Secure="yes" />
    <Property Id="PORTALKEY" Secure="yes" />
    <Property Id="PORTALNAME" Secure="yes" />
    <Property Id="PORTALURL" Secure="yes" />
    <!-- Set ENABLETRAY=1 for workstations, omit or set to 0 for servers -->
    <Property Id="ENABLETRAY" Value="1" Secure="yes" />

    <!-- Custom action to update config.json with provided credentials -->
    <!-- All properties are quoted so empty values don't shift subsequent arguments -->
    <CustomAction Id="UpdateConfig"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]VanguardAgent.exe --register --user-id &quot;[USERID]&quot; --secret-key &quot;[SECRETKEY]&quot; --client-id &quot;[CLIENTID]&quot; --portal-key &quot;[PORTALKEY]&quot; --portal-name &quot;[PORTALNAME]&quot; --portal-url &quot;[PORTALURL]&quot; --show-portal 1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UpdateConfig" Before="StartServices" Condition="USERID AND SECRETKEY" />
    </InstallExecuteSequence>

  </Package>
</Wix>
