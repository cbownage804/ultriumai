<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 4 MSI Installer for Vanguard Customer Portal
  Build: wix build VanguardPortal.wxs -o VanguardPortal.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Vanguard Customer Portal"
           Manufacturer="Ultrium AI"
           Version="1.0.0"
           UpgradeCode="E5F6A7B8-C9D0-1234-EF01-234567890ABC"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <Media Id="1" Cabinet="portal.cab" EmbedCab="yes" />

    <!-- Per-user installation -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="VanguardPortal">
        <Component Id="MainExecutable" Guid="F6A7B8C9-D0E1-2345-F012-34567890ABCD">
          <File Id="VanguardPortalExe" 
                Source="$(var.PublishDir)\VanguardPortal.exe" 
                KeyPath="yes" />
          <File Id="ConfigJson" 
                Source="$(var.PublishDir)\config.json" />
        </Component>

        <!-- Auto-start on login -->
        <Component Id="StartupShortcut" Guid="A7B8C9D0-E1F2-3456-0123-4567890ABCDE">
          <RegistryValue Root="HKCU" 
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="VanguardPortal"
                         Value="[INSTALLFOLDER]VanguardPortal.exe"
                         Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Vanguard Portal">
        <Component Id="StartMenuShortcut" Guid="B8C9D0E1-F234-5678-1234-567890ABCDEF">
          <Shortcut Id="PortalShortcut"
                    Name="Vanguard Portal"
                    Description="Vanguard Customer Support Portal"
                    Target="[INSTALLFOLDER]VanguardPortal.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Ultrium\VanguardPortal" 
                         Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="Vanguard Portal" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartupShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Silent install properties -->
    <Property Id="PORTALKEY" Secure="yes" />
    <Property Id="APIENDPOINT" Secure="yes" />

  </Package>
</Wix>
